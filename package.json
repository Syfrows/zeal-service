{
  "name": "zeal-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "populate": "ts-node populate.ts",
    "compile-admin-ui": "ts-node src/compile-admin-ui.ts",
    "run:server": "ts-node ./src/index.ts",
    "run:worker": "ts-node ./src/index-worker.ts",
    "start:server": "node ./dist/src/index.js",
    "start:worker": "node ./dist/src/index-worker.js",
    "start": "concurrently yarn:run:*",
    "build": "rimraf dist && rimraf admin-ui && tsc && tsc -p tsconfig.migrations.json && yarn compile-admin-ui",
    "codegen": "graphql-codegen --config ./codegen.ts",
    "migration:generate": "ts-node migration generate",
    "migration:run": "ts-node migration run",
    "migration:revert": "ts-node migration revert",
    "lint:fix": "eslint ./src/ --ext .ts --fix",
    "e2e:reviews": "vitest --config src/plugins/reviews/e2e/config/vitest.config.js",
    "prepare": "husky install",
    "build:prod": "rimraf dist && rimraf admin-ui && tsc && tsc -p tsconfig.migrations.json",
    "prod": "yarn build:prod && cp -r static dist && tar -czvf zeal-service.tar.gz dist",
    "prod-nm": "yarn build:prod && cp -r static dist && tar -czvf zeal-service.tar.gz dist node_modules",
    "admin": "rimraf admin-ui && yarn compile-admin-ui && tar -czvf zeal-admin.tar.gz -C admin-ui/dist ."
  },
  "dependencies": {
    "@pinelab/vendure-plugin-invoices": "^2.1.0",
    "@vendure/admin-ui-plugin": "^2.0.0",
    "@vendure/asset-server-plugin": "^2.0.0",
    "@vendure/core": "^2.0.0",
    "@vendure/email-plugin": "^2.0.0",
    "axios": "^1.6.8",
    "dotenv": "16.1.4",
    "google-auth-library": "^9.4.1",
    "pg": "8.11.0",
    "vendure-razorpay-payment-plugin": "^0.0.10"
  },
  "devDependencies": {
    "@graphql-codegen/add": "5.0.0",
    "@graphql-codegen/cli": "4.0.1",
    "@graphql-codegen/typed-document-node": "^5.0.0",
    "@graphql-codegen/typescript": "4.0.0",
    "@graphql-codegen/typescript-compatibility": "2.1.5",
    "@graphql-codegen/typescript-operations": "4.0.0",
    "@swc/core": "^1.3.62",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.59.9",
    "@vendure/create": "^2.0.0",
    "@vendure/testing": "^2.0.0",
    "@vendure/ui-devkit": "^2.0.0",
    "concurrently": "8.1.0",
    "eslint": "^8.42.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "prettier": "^2.8.8",
    "ts-node": "10.9.1",
    "typescript": "4.9.5",
    "unplugin-swc": "^1.3.2",
    "vitest": "^0.32.0"
  },
  "overrides": {
    "graphql": "16.6.0"
  },
  "lint-staged": {
    "*.{js,css,md,ts,tsx}": "prettier --write"
  }
}
